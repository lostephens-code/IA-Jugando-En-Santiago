<?xml version="1.0" encoding="utf-8"?>
<!--
    Primer plano del ícono: una "pantalla" con cuatro barras de distinto alto,
    que representan las cuatro barras superiores de este ejemplo.
    El lienzo es de 108x108; la zona segura visible es el centro de 72x72.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Marco blanco de la pantalla -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M34,30h40a4,4 0,0 1,4 4v40a4,4 0,0 1,-4 4h-40a4,4 0,0 1,-4 -4v-40a4,4 0,0 1,4 -4z" />

    <!-- Barra 1: TopAppBar (fina) -->
    <path
        android:fillColor="#6750A4"
        android:pathData="M34,34h40v5h-40z" />
    <!-- Barra 2: CenterAligned -->
    <path
        android:fillColor="#00897B"
        android:pathData="M34,42h40v6h-40z" />
    <!-- Barra 3: Medium -->
    <path
        android:fillColor="#EF6C00"
        android:pathData="M34,51h40v9h-40z" />
    <!-- Barra 4: Large -->
    <path
        android:fillColor="#C2185B"
        android:pathData="M34,63h40v11h-40z" />
</vector>
